    } nubs;

    lookup fallback {
        # Vendor rules, kept as a fallback for pairs that collide.
        sub f' [v w x y] by f.calt;
        sub g' [y] by g.calt;
    } fallback;

    lookup restyle {
        # C -> C.swsh (swsh, unconditional)
        sub C by C.swsh;
        # e -> e.swsh (swsh, unconditional)
        sub e by e.swsh;
        # i -> i.salt (salt, unconditional)
        sub i by i.salt;
    } restyle;
} calt;
